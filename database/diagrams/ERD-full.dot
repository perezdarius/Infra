digraph InfraCare {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.45", nodesep="0.45", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", fontsize=22, label="InfraCare | Database relationships
18 October 2026 · solid lines = enforced foreign keys", labelloc=t];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", arrowsize=0.8];
AUTH_USERS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>auth.users (managed)</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR></TABLE>>];
AUDIT_LOG [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">entity</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">entity_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">detail ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
INFRASTRUCTURE_ITEMS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>infrastructure_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_category </FONT></TD></TR><TR><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">description ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">created_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
MAINTENANCE_RECORDS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>maintenance_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">infrastructure_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">office ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">work_description</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">maintenance_status </FONT></TD></TR><TR><TD ALIGN="LEFT">scheduled_date ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date </FONT></TD></TR><TR><TD ALIGN="LEFT">completed_date ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date </FONT></TD></TR><TR><TD ALIGN="LEFT">cost ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(12,2) </FONT></TD></TR><TR><TD ALIGN="LEFT">created_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
PROFILES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">phone ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">barangay ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
REPORT_ATTACHMENTS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_attachments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">uploaded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">storage_path</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">mime_type</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">size_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
REPORT_INTERNAL_NOTES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_internal_notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">author_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
REPORT_RESOLUTIONS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_resolutions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">reply</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">photos</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">jsonb </FONT></TD></TR><TR><TD ALIGN="LEFT">uploaded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
REPORT_STATUS_HISTORY [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">from_status ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_status </FONT></TD></TR><TR><TD ALIGN="LEFT">to_status</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_status </FONT></TD></TR><TR><TD ALIGN="LEFT">note ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">changed_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR></TABLE>>];
REPORTS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reference_no</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">reporter_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_category </FONT></TD></TR><TR><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_severity </FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">landmark ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">latitude ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">double precision </FONT></TD></TR><TR><TD ALIGN="LEFT">longitude ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">double precision </FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_status </FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">report_priority </FONT></TD></TR><TR><TD ALIGN="LEFT">assigned_office ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">assigned_to ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">duplicate_of ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">duplicate_reason ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">archived_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone </FONT></TD></TR><TR><TD ALIGN="LEFT">archived_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid </FONT></TD></TR><TR><TD ALIGN="LEFT">archive_reason ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">barangay ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">contact_phone ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text </FONT></TD></TR><TR><TD ALIGN="LEFT">resolution_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
USER_ROLES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>user_roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">app_role </FONT></TD></TR></TABLE>>];
MAINTENANCE_RECORDS -> INFRASTRUCTURE_ITEMS [label="infrastructure_id (optional)", constraint=true];
MAINTENANCE_RECORDS -> REPORTS [label="report_id (optional)", constraint=true];
PROFILES -> AUTH_USERS [label="id (required)", constraint=true];
REPORT_ATTACHMENTS -> REPORTS [label="report_id (required)", constraint=true];
REPORT_INTERNAL_NOTES -> REPORTS [label="report_id (required)", constraint=true];
REPORT_RESOLUTIONS -> REPORTS [label="report_id (required)", constraint=true];
REPORT_STATUS_HISTORY -> REPORTS [label="report_id (required)", constraint=true];
REPORTS -> REPORTS [label="duplicate_of (optional)", constraint=false];
REPORTS -> REPORT_RESOLUTIONS [label="resolution_id (optional)", constraint=false];
USER_ROLES -> AUTH_USERS [label="user_id (required)", constraint=true];
legend [label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT">PK = primary key · FK = foreign key · ? = nullable</TD></TR><TR><TD ALIGN="LEFT">Account UUIDs and storage paths without constraints are logical references only.</TD></TR><TR><TD ALIGN="LEFT">Arrow points from the referencing table to its parent.</TD></TR></TABLE>>];
}
