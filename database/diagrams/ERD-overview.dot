digraph InfraCare {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.45", nodesep="0.45", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", fontsize=22, label="InfraCare | Database relationships
18 October 2026 · solid lines = enforced foreign keys", labelloc=t];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", arrowsize=0.8];
AUTH_USERS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>auth.users (managed)</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR></TABLE>>];
AUDIT_LOG [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR></TABLE>>];
INFRASTRUCTURE_ITEMS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>infrastructure_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR></TABLE>>];
MAINTENANCE_RECORDS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>maintenance_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">infrastructure_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
PROFILES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR></TABLE>>];
REPORT_ATTACHMENTS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_attachments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
REPORT_INTERNAL_NOTES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_internal_notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
REPORT_RESOLUTIONS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_resolutions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
REPORT_STATUS_HISTORY [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>report_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
REPORTS [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">duplicate_of ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR><TR><TD ALIGN="LEFT">resolution_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
USER_ROLES [label=<<TABLE BORDER="1" COLOR="#d7dce2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#ee5a64"><FONT COLOR="#ffffff"><B>user_roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">uuid FK</FONT></TD></TR></TABLE>>];
MAINTENANCE_RECORDS -> INFRASTRUCTURE_ITEMS [label="infrastructure_id (optional)", constraint=true];
MAINTENANCE_RECORDS -> REPORTS [label="report_id (optional)", constraint=true];
PROFILES -> AUTH_USERS [label="id (required)", constraint=true];
REPORT_ATTACHMENTS -> REPORTS [label="report_id (required)", constraint=true];
REPORT_INTERNAL_NOTES -> REPORTS [label="report_id (required)", constraint=true];
REPORT_RESOLUTIONS -> REPORTS [label="report_id (required)", constraint=true];
REPORT_STATUS_HISTORY -> REPORTS [label="report_id (required)", constraint=true];
REPORTS -> REPORTS [label="duplicate_of (optional)", constraint=false];
REPORTS -> REPORT_RESOLUTIONS [label="resolution_id (optional)", constraint=false];
USER_ROLES -> AUTH_USERS [label="user_id (required)", constraint=true];
legend [label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT">PK = primary key · FK = foreign key · ? = nullable</TD></TR><TR><TD ALIGN="LEFT">Account UUIDs and storage paths without constraints are logical references only.</TD></TR><TR><TD ALIGN="LEFT">Arrow points from the referencing table to its parent.</TD></TR></TABLE>>];
}
