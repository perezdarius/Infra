# Configuration template only. No real credentials are included.
# Browser values must be publishable, never privileged.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only values are injected by the deployment environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional standalone-host secret; unavailable for export from Lovable Cloud.
SUPABASE_SERVICE_ROLE_KEY=
# Optional migration connection for a separately provisioned database.
LOVABLE_DB_MIGRATION_URL=
